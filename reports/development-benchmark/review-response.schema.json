{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent human response array",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "status",
      "human_label",
      "reviewer_id",
      "reviewed_at",
      "rationale",
      "adjudicator_id",
      "review_id"
    ],
    "properties": {
      "status": {
        "enum": [
          "pending_human_review",
          "human_reviewed",
          "adjudicated"
        ]
      },
      "human_label": {
        "enum": [
          null,
          "spoiler",
          "safe",
          "uncertain"
        ]
      },
      "reviewer_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "reviewed_at": {
        "type": [
          "string",
          "null"
        ]
      },
      "rationale": {
        "type": [
          "string",
          "null"
        ]
      },
      "adjudicator_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "triggering_quote": {
        "type": [
          "string",
          "null"
        ]
      },
      "review_id": {
        "type": "string",
        "pattern": "^R[0-9]{3}$"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "pending_human_review"
            }
          }
        },
        "then": {
          "properties": {
            "human_label": {
              "type": "null"
            },
            "reviewer_id": {
              "type": "null"
            },
            "reviewed_at": {
              "type": "null"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "human_reviewed",
                "adjudicated"
              ]
            }
          }
        },
        "then": {
          "required": [
            "triggering_quote"
          ],
          "properties": {
            "human_label": {
              "enum": [
                "spoiler",
                "safe",
                "uncertain"
              ]
            },
            "reviewer_id": {
              "type": "string",
              "minLength": 1
            },
            "reviewed_at": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "adjudicated"
            }
          }
        },
        "then": {
          "properties": {
            "adjudicator_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "human_label": {
              "const": "spoiler"
            }
          }
        },
        "then": {
          "required": [
            "triggering_quote"
          ],
          "properties": {
            "triggering_quote": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    ]
  }
}
